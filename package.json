{
  "name": "@connectome/agent-core",
  "version": "0.1.0",
  "description": "Connectome agent core — pi-agent wrapped in VEIL-native agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "dev": "tsx --watch src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.26.4",
    "@anthropic-ai/sdk": "0.61.0",
    "@connectome/connectome-ts": "workspace:*",
    "@mariozechner/pi-agent-core": "^0.53.0",
    "@mariozechner/pi-ai": "^0.53.0",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
